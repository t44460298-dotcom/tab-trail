{
  "manifest_version": 3,
  "name": "标签脉络",
  "description": "按打开关系把标签整理成树，记录看没看过、何时看过；按工作区分开，随时收起和恢复。",
  "version": "0.6.0",
  "permissions": ["tabs", "storage", "unlimitedStorage", "alarms", "sidePanel", "favicon"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "打开标签脉络",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "sidebar_action": {
    "default_panel": "panel/panel.html",
    "default_title": "标签脉络",
    "default_icon": "icons/icon32.png",
    "open_at_install": false
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+Q" },
      "description": "打开标签脉络"
    },
    "open-switcher": {
      "suggested_key": { "default": "Alt+K" },
      "description": "快速搜索并切换标签"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-trail@local",
      "strict_min_version": "121.0"
    }
  }
}
